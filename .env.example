# URL pública do Apps Script publicado como Web App.
# Obtida em: Apps Script → Implantar → Nova implantação → App da Web.
PUBLIC_GAS_URL=https://script.google.com/macros/s/COLOQUE_O_ID_AQUI/exec

# Número que recebe o pedido pelo WhatsApp (formato internacional, sem +, sem espaços).
PUBLIC_WHATSAPP_NUMBER=5531989795391

# PIN de 4 dígitos para acesso à página de cadastro admin (/admin/cadastro).
# Se vazio, o gate é desativado (útil em dev local).
# Defina também como Repository Variable no GitHub (vars.PUBLIC_ADMIN_PIN).
PUBLIC_ADMIN_PIN=

# Token de acesso à API Cosmos Bluesoft (api.cosmos.bluesoft.com.br).
# Obtenha em: https://cosmos.bluesoft.com.br → Minha conta → Token de acesso.
# Se vazio, o fallback Open Food Facts é usado diretamente.
PUBLIC_COSMOS_TOKEN=
