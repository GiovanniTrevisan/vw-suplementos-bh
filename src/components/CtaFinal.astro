---
import { ArrowRight } from '@lucide/astro';

const base = import.meta.env.BASE_URL;
---

<section class="cta-final">
  <div class="cta-inner container" data-reveal>
    <div class="cta-left">
      <span class="cta-kick">// PRÓXIMO PASSO</span>
      <h2 class="cta-heading">PRONTO PARA<br/>EVOLUIR?</h2>
      <p class="cta-sub">Monte seu pedido no catálogo e nos mande pelo WhatsApp.<br/>Entregamos em BH ou você retira na loja do Castelo.</p>
    </div>
    <div class="cta-right">
      <a href={`${base}catalogo`} class="cta-btn-pri">
        <ArrowRight size={18} color="var(--c-master)" />
        <span>ACESSAR O CATÁLOGO</span>
      </a>
      <span class="cta-sub2">FRETE A COMBINAR · WHATSAPP DIRETO</span>
    </div>
  </div>
</section>

<style>
  .cta-final {
    background: var(--c-master);
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .cta-final::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 20% 80%, rgba(10, 10, 9, 0.08), transparent 60%);
    pointer-events: none;
  }

  .cta-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
    padding: var(--section-y) var(--gutter);
    position: relative;
  }

  .cta-left {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2vw, 28px);
  }

  .cta-kick {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--c-ink);
  }

  .cta-heading {
    font-family: var(--font-display);
    font-size: clamp(48px, 8vw, 112px);
    font-weight: 800;
    font-style: italic;
    line-height: 0.9;
    letter-spacing: -3px;
    color: var(--c-ink);
  }

  .cta-sub {
    font-family: var(--font-ui);
    font-size: clamp(15px, 1.2vw, 18px);
    line-height: 1.55;
    color: var(--c-ink);
  }

  .cta-right {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-end;
  }

  .cta-btn-pri {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 22px 36px;
    background: var(--c-ink);
    border-radius: var(--radius-sm);
    color: var(--c-paper);
    font-family: var(--font-display);
    font-size: clamp(15px, 1.2vw, 18px);
    font-weight: 800;
    letter-spacing: 2px;
    transition: transform var(--t-med) var(--ease-out), box-shadow var(--t-med) var(--ease-out);
  }

  .cta-btn-pri:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -14px rgba(10, 10, 9, 0.5);
  }
  .cta-btn-pri :global(svg) { transition: transform var(--t-med) var(--ease-out); }
  .cta-btn-pri:hover :global(svg) { transform: translateX(5px); }

  .cta-sub2 {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--c-ink);
  }

  @media (max-width: 900px) {
    .cta-inner { grid-template-columns: 1fr; }
    .cta-right { align-items: stretch; }
    .cta-btn-pri { justify-content: center; }
    .cta-sub2 { text-align: center; }
  }
</style>
