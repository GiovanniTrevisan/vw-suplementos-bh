---
import { ShoppingBag, ArrowRight } from '@lucide/astro';

interface Props {
  variant?: 'dark' | 'light';
}

const { variant = 'dark' } = Astro.props;
---

<header class:list={['header', variant]}>
  <a href="/" class="logo">
    <img src="/logo_dark.png" alt="VW Suplementos" class="logo-img" />
    <span class="logo-badge">BH</span>
  </a>

  <nav class="nav">
    <a href="/#inicio">Início</a>
    <a href="/catalogo">Produtos</a>
    <a href="/#sobre">Sobre</a>
    <a href="/#localizacao">Localização</a>
  </nav>

  <div class="actions">
    <a href="/catalogo" class="cta-catalogo">
      <span>VER CATÁLOGO</span>
      <ArrowRight size={16} />
    </a>
    <a href="/checkout" class="cart">
      <ShoppingBag size={22} color="var(--c-paper)" />
      <span class="cart-badge">2</span>
    </a>
  </div>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 40px;
    background: var(--c-ink);
    width: 100%;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .logo-img {
    width: 180px;
    height: 40px;
    object-fit: contain;
  }

  .logo-badge {
    color: var(--c-yellow);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .nav a {
    color: var(--c-paper);
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .nav a:hover {
    opacity: 0.7;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .cta-catalogo {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 22px;
    background: var(--c-yellow);
    border-radius: var(--radius-pill);
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1px;
    transition: opacity 0.2s;
  }

  .cta-catalogo:hover {
    opacity: 0.85;
  }

  .cart {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cart-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    background: var(--c-yellow);
    border-radius: var(--radius-pill);
    color: var(--c-ink);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .nav { display: none; }
    .header { padding: 16px 20px; }
  }
</style>
