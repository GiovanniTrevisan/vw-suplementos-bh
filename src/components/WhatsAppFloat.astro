---
import { WHATSAPP_NUMBER } from '../lib/config';
import { buildWhatsAppLink } from '../lib/format';

interface Props {
  message?: string;
  tooltip?: string;
  hideOnPaths?: string[];
  showAfterMs?: number;
}

const {
  message = 'Olá! Vim pelo site e gostaria de saber mais sobre os suplementos.',
  tooltip = 'Fale com um especialista',
  hideOnPaths = ['/checkout'],
  showAfterMs = 2400,
} = Astro.props;

const href = buildWhatsAppLink(WHATSAPP_NUMBER, message);
---

<a
  href={href}
  class="wa-float"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${tooltip} pelo WhatsApp`}
  data-cta="whatsapp-float"
  data-wa-float
  data-hide-paths={JSON.stringify(hideOnPaths)}
  data-show-after={showAfterMs}
>
  <span class="wa-float__pulse" aria-hidden="true"></span>
  <span class="wa-float__bubble">
    <svg class="wa-float__icon" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true" focusable="false">
      <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
      <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
      <g id="SVGRepo_iconCarrier"> 
      <title>whatsapp</title> 
      <path d="M26.576 5.363c-2.69-2.69-6.406-4.354-10.511-4.354-8.209 0-14.865 6.655-14.865 14.865 0 2.732 0.737 5.291 2.022 7.491l-0.038-0.070-2.109 7.702 7.879-2.067c2.051 1.139 4.498 1.809 7.102 1.809h0.006c8.209-0.003 14.862-6.659 14.862-14.868 0-4.103-1.662-7.817-4.349-10.507l0 0zM16.062 28.228h-0.005c-0 0-0.001 0-0.001 0-2.319 0-4.489-0.64-6.342-1.753l0.056 0.031-0.451-0.267-4.675 1.227 1.247-4.559-0.294-0.467c-1.185-1.862-1.889-4.131-1.889-6.565 0-6.822 5.531-12.353 12.353-12.353s12.353 5.531 12.353 12.353c0 6.822-5.53 12.353-12.353 12.353h-0zM22.838 18.977c-0.371-0.186-2.197-1.083-2.537-1.208-0.341-0.124-0.589-0.185-0.837 0.187-0.246 0.371-0.958 1.207-1.175 1.455-0.216 0.249-0.434 0.279-0.805 0.094-1.15-0.466-2.138-1.087-2.997-1.852l0.010 0.009c-0.799-0.74-1.484-1.587-2.037-2.521l-0.028-0.052c-0.216-0.371-0.023-0.572 0.162-0.757 0.167-0.166 0.372-0.434 0.557-0.65 0.146-0.179 0.271-0.384 0.366-0.604l0.006-0.017c0.043-0.087 0.068-0.188 0.068-0.296 0-0.131-0.037-0.253-0.101-0.357l0.002 0.003c-0.094-0.186-0.836-2.014-1.145-2.758-0.302-0.724-0.609-0.625-0.836-0.637-0.216-0.010-0.464-0.012-0.712-0.012-0.395 0.010-0.746 0.188-0.988 0.463l-0.001 0.002c-0.802 0.761-1.3 1.834-1.3 3.023 0 0.026 0 0.053 0.001 0.079l-0-0.004c0.131 1.467 0.681 2.784 1.527 3.857l-0.012-0.015c1.604 2.379 3.742 4.282 6.251 5.564l0.094 0.043c0.548 0.248 1.25 0.513 1.968 0.74l0.149 0.041c0.442 0.14 0.951 0.221 1.479 0.221 0.303 0 0.601-0.027 0.889-0.078l-0.031 0.004c1.069-0.223 1.956-0.868 2.497-1.749l0.009-0.017c0.165-0.366 0.261-0.793 0.261-1.242 0-0.185-0.016-0.366-0.047-0.542l0.003 0.019c-0.092-0.155-0.34-0.247-0.712-0.434z">
        </path> 
      </g>
    </svg>
  </span>
  <span class="wa-float__tooltip" role="tooltip">
    <strong>{tooltip}</strong>
    <small>Atendimento rápido no WhatsApp</small>
  </span>
</a>

<script is:inline>
  (() => {
    const btn = document.querySelector('[data-wa-float]');
    if (!btn) return;

    let hidePaths = [];
    try { hidePaths = JSON.parse(btn.getAttribute('data-hide-paths') || '[]'); } catch (_) {}
    const base = (document.querySelector('base')?.getAttribute('href') || '/').replace(/\/$/, '');
    const path = window.location.pathname.replace(base, '') || '/';
    const isHidden = hidePaths.some((p) => path === p || path.startsWith(p + '/'));
    if (isHidden) {
      btn.remove();
      return;
    }

    const delay = Number(btn.getAttribute('data-show-after') || 2400);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion) {
      btn.classList.add('is-visible', 'is-static');
    } else {
      setTimeout(() => btn.classList.add('is-visible'), delay);
    }

    btn.addEventListener('click', () => {
      try {
        const payload = {
          event: 'whatsapp_click',
          location: 'floating_button',
          path: window.location.pathname,
        };
        if (window.dataLayer && typeof window.dataLayer.push === 'function') {
          window.dataLayer.push(payload);
        }
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'whatsapp_click', { location: 'floating_button' });
        }
      } catch (_) {}
    });
  })();
</script>

<style>
  .wa-float {
    --wa-green-1: #2EE072;
    --wa-green-2: #25D366;
    --wa-green-3: #1FB855;
    --wa-size: 60px;

    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    bottom: calc(28px + env(safe-area-inset-bottom));
    z-index: 60;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #FFFFFF;

    opacity: 0;
    transform: translate3d(0, 16px, 0) scale(0.85);
    transition:
      opacity 480ms var(--ease-out),
      transform 480ms var(--ease-out);
    will-change: transform, opacity;
  }
  .wa-float.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  .wa-float__bubble {
    position: relative;
    width: var(--wa-size);
    height: var(--wa-size);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--wa-green-1) 0%, var(--wa-green-2) 55%, var(--wa-green-3) 100%);
    transition: transform 320ms var(--ease-out), box-shadow 320ms var(--ease-out);
        box-shadow: 0 0 32px -5px rgba(0, 0, 0, 0.5);

  }

  .wa-float__icon {
    width: 30px;
    height: 30px;
    color: #FFFFFF;
    filter: drop-shadow(0 0 0 rgba(0, 0, 0, 0.18));
  }

  .wa-float__pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(37, 211, 102, 0.45);
    z-index: -1;
    animation: wa-pulse 2.6s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }
  .wa-float.is-static .wa-float__pulse { animation: none; display: none; }

  @keyframes wa-pulse {
    0%   { transform: scale(0.9); opacity: 0.55; }
    70%  { transform: scale(1.55); opacity: 0; }
    100% { transform: scale(1.55); opacity: 0; }
  }

  .wa-float.is-static .wa-float__dot { animation: none; }

  @keyframes wa-blink {
    0%, 100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.55); }
    50%      { box-shadow: 0 0 0 6px rgba(52, 211, 153, 0); }
  }

  /* ---------- Tooltip (desktop only, on hover/focus) ---------- */
  .wa-float__tooltip {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    transform: translateY(-50%) translateX(8px);
    display: none;
    flex-direction: column;
    gap: 2px;
    padding: 10px 14px;
    background: var(--c-ink);
    color: var(--c-paper);
    border-radius: var(--radius-md);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    box-shadow: 0 12px 32px -10px rgba(0, 0, 0, 0.35);
    transition: opacity 240ms var(--ease-out), transform 240ms var(--ease-out);
  }
  .wa-float__tooltip::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -5px;
    width: 10px;
    height: 10px;
    background: var(--c-ink);
    transform: translateY(-50%) rotate(45deg);
    border-radius: 2px;
  }
  .wa-float__tooltip strong {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.5px;
  }
  .wa-float__tooltip small {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--c-paper-muted);
    text-transform: uppercase;
  }

  /* ---------- Interactions ---------- */
  .wa-float:hover .wa-float__bubble,
  .wa-float:focus-visible .wa-float__bubble {
    transform: scale(1.04);
   
  }
  .wa-float:active .wa-float__bubble {
    transform: translateY(-1px) scale(0.98);
  }
  .wa-float:focus-visible {
    outline: none;
  }
  .wa-float:focus-visible .wa-float__bubble {
    box-shadow:
      0 0 0 3px rgba(255, 255, 255, 0.85),
      0 0 0 6px rgba(37, 211, 102, 0.6),
      0 14px 32px -6px rgba(37, 211, 102, 0.5);
  }

  /* ---------- Desktop refinements ---------- */
  @media (min-width: 1024px) {
    .wa-float {
      --wa-size: 60px;
      right: max(32px, env(safe-area-inset-right));
      bottom: 32px;
    }
    .wa-float__icon { width: 28px; height: 28px; }
    .wa-float__tooltip { display: inline-flex; }
    .wa-float:hover .wa-float__tooltip,
    .wa-float:focus-visible .wa-float__tooltip {
      opacity: 1;
      transform: translateY(-50%) translateX(0);
    }
  }

  /* ---------- Mobile (bounce only on first appearance) ---------- */
  @media (max-width: 1023px) {
    .wa-float.is-visible .wa-float__bubble {
      animation: wa-bounce-in 720ms cubic-bezier(0.34, 1.56, 0.64, 1) 1;
    }
  }
  @keyframes wa-bounce-in {
    0%   { transform: translateY(8px) scale(0.7); }
    60%  { transform: translateY(-4px) scale(1.06); }
    100% { transform: translateY(0) scale(1); }
  }

  /* ---------- Reduced motion ---------- */
  @media (prefers-reduced-motion: reduce) {
    .wa-float {
      transition: none;
      opacity: 1;
      transform: none;
    }
    .wa-float__pulse,
    .wa-float__dot,
    .wa-float.is-visible .wa-float__bubble {
      animation: none !important;
    }
  }

  /* ---------- High contrast / forced colors ---------- */
  @media (forced-colors: active) {
    .wa-float__bubble {
      background: CanvasText;
      border: 2px solid CanvasText;
    }
    .wa-float__tooltip { border: 1px solid CanvasText; }
  }
</style>
