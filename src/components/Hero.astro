---
import { ArrowRight, MessageCircle } from '@lucide/astro';
import { WHATSAPP_NUMBER } from '../lib/config';
import { buildWhatsAppLink } from '../lib/format';

const whatsappLink = buildWhatsAppLink(WHATSAPP_NUMBER, 'Olá! Gostaria de mais informações sobre os produtos da VW Suplementos.');
---

<section class="hero" id="inicio">
  <div class="hero-inner container">
    <div class="hero-left" data-reveal="left">
      <div class="kicker">
        <div class="kicker-line"></div>
        <span>VW SUPLEMENTOS · BH CASTELO</span>
      </div>
      <h1 class="hero-title">SEU TREINO MERECE O MELHOR.</h1>
      <p class="hero-sub">Whey, creatina, pré-treino e acessórios das principais marcas. Originais, com nota fiscal e entrega rápida em Belo Horizonte.</p>
      <div class="ctas">
        <a href="/catalogo" class="cta-primary">
          <span>VER CATÁLOGO</span>
          <ArrowRight size={18} />
        </a>
        <a href={whatsappLink} class="cta-secondary" target="_blank" rel="noopener noreferrer">
          <MessageCircle size={18} />
          <span>FALAR NO WHATSAPP</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(to right, #000000df 30%, rgba(169, 24, 24, 0.486)), url('/wallpaper_2.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 80% 20%, rgba(245, 195, 0, 0.08), transparent 50%);
    pointer-events: none;
  }

  .hero-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(60px, 8vw, 100px) var(--gutter);
    min-height: clamp(560px, 80vh, 760px);
    position: relative;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(20px, 2.5vw, 32px);
    width: 100%;
    min-width: 0;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .kicker-line {
    width: 36px;
    height: 2px;
    background: var(--c-paper);
    animation: slideInLeft var(--t-slow) var(--ease-out) both;
  }

  .kicker span {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
    color: var(--c-paper);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(48px, 9vw, 120px);
    font-weight: 800;
    font-style: italic;
    line-height: 0.9;
    letter-spacing: -2px;
    color: var(--c-paper);
    text-shadow: 0 10px 44px rgba(0,0,0,0.9);
  }

  .hero-sub {
    max-width: 540px;
    font-family: var(--font-ui);
    font-size: clamp(15px, 1.2vw, 18px);
    line-height: 1.55;
    color: var(--c-paper-muted);
  }

  .ctas {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .cta-primary,
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 17px 28px;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
    transition: transform var(--t-med) var(--ease-out), box-shadow var(--t-med) var(--ease-out), background var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
  }

  .cta-primary {
    background: var(--c-paper);
    color: var(--c-ink);
  }
  .cta-primary:hover {
    transform: translateY(-3px);
  }
  .cta-primary :global(svg) { transition: transform var(--t-med) var(--ease-out); }
  .cta-primary:hover :global(svg) { transform: translateX(4px); }

  .cta-secondary {
    border: 2px solid var(--c-paper);
    color: var(--c-paper);
      background: var(--c-paper);
    color: var(--c-ink);
  }
  .cta-secondary:hover {
    background: var(--c-paper);
    color: var(--c-ink);
    transform: translateY(-3px);
  }
</style>
