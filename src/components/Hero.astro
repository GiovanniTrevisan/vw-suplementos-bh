---
import { ArrowRight, MessageCircle } from '@lucide/astro';
---

<section class="hero" id="inicio">
  <div class="hero-inner container">
    <div class="hero-left" data-reveal="left">
      <div class="kicker">
        <div class="kicker-line"></div>
        <span>VW SUPLEMENTOS · BH CASTELO</span>
      </div>
      <h1 class="hero-title">SEU TREINO MERECE O MELHOR.</h1>
      <p class="hero-sub">Whey, creatina, pré-treino e acessórios das principais marcas. Originais, com nota fiscal e entrega rápida em Belo Horizonte.</p>
      <div class="ctas">
        <a href="/catalogo" class="cta-primary">
          <span>VER CATÁLOGO</span>
          <ArrowRight size={18} />
        </a>
        <a href="#" class="cta-secondary">
          <MessageCircle size={18} />
          <span>FALAR NO WHATSAPP</span>
        </a>
      </div>
    </div>
    <div class="hero-right" data-reveal="right">
      <div class="yellow-accent"></div>
      <div class="product-mock">
        <div class="product-inner"></div>
      </div>
      <div class="rating-badge">
        <span>4.7★ NO GOOGLE</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--c-paper);
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 80% 20%, rgba(245, 195, 0, 0.08), transparent 50%);
    pointer-events: none;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr minmax(0, 480px);
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
    padding: clamp(60px, 8vw, 100px) var(--gutter);
    min-height: clamp(560px, 80vh, 760px);
    position: relative;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.5vw, 32px);
    min-width: 0;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .kicker-line {
    width: 36px;
    height: 2px;
    background: var(--c-ink);
    animation: slideInLeft var(--t-slow) var(--ease-out) both;
  }

  .kicker span {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
    color: var(--c-ink);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(48px, 9vw, 120px);
    font-weight: 800;
    font-style: italic;
    line-height: 0.9;
    letter-spacing: -2px;
    color: var(--c-ink);
  }

  .hero-sub {
    max-width: 540px;
    font-family: var(--font-ui);
    font-size: clamp(15px, 1.2vw, 18px);
    line-height: 1.55;
    color: var(--c-mid);
  }

  .ctas {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .cta-primary,
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 17px 28px;
    border-radius: var(--radius-pill);
    color: var(--c-ink);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
    transition: transform var(--t-med) var(--ease-out), box-shadow var(--t-med) var(--ease-out), background var(--t-fast) var(--ease-out);
  }

  .cta-primary {
    background: var(--c-yellow);
  }
  .cta-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px -12px rgba(245, 195, 0, 0.55);
  }
  .cta-primary :global(svg) { transition: transform var(--t-med) var(--ease-out); }
  .cta-primary:hover :global(svg) { transform: translateX(4px); }

  .cta-secondary {
    border: 2px solid var(--c-ink);
    background: transparent;
  }
  .cta-secondary:hover {
    background: var(--c-ink);
    color: var(--c-paper);
    transform: translateY(-3px);
  }

  .hero-right {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 620px;
    background: var(--c-mid);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 30px 80px -30px rgba(10, 10, 9, 0.4);
  }

  .yellow-accent {
    position: absolute;
    left: 0;
    top: 12%;
    width: 8px;
    height: 70%;
    background: var(--c-yellow);
    transform-origin: top;
    animation: scaleY-grow 900ms var(--ease-out) 200ms both;
  }

  @keyframes scaleY-grow {
    from { transform: scaleY(0); }
    to   { transform: scaleY(1); }
  }

  .product-mock {
    position: absolute;
    left: 16%;
    top: 10%;
    width: 65%;
    height: 80%;
    background: var(--c-ink);
    border-radius: var(--radius-md);
    animation: floatY 6s var(--ease-in-out) infinite;
  }

  .rating-badge {
    position: absolute;
    left: 5%;
    bottom: 7%;
    background: var(--c-yellow);
    border-radius: var(--radius-sm);
    padding: 10px 16px;
    transform: rotate(12deg);
    box-shadow: 0 10px 24px -8px rgba(0,0,0,0.3);
    animation: scaleIn var(--t-slow) var(--ease-out) 400ms both;
  }

  .rating-badge span {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--c-ink);
  }

  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-right {
      aspect-ratio: 16 / 11;
      max-height: 420px;
    }
  }
</style>
