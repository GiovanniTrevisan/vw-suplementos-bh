---
import { MapPin, Clock, Phone, Map, MessageCircle } from '@lucide/astro';
import { WHATSAPP_NUMBER } from '../lib/config';
import { buildWhatsAppLink } from '../lib/format';

const whatsappLink = buildWhatsAppLink(WHATSAPP_NUMBER, 'Olá! Gostaria de mais informações sobre os produtos da VW Suplementos.');
---

<section class="localizacao" id="localizacao">
  <div class="loc-inner container">
    <div class="loc-left" data-reveal="left">
      <span class="loc-kicker">VENHA NA LOJA</span>
      <h2 class="loc-title">ONDE ESTAMOS.</h2>

      <div class="addr-block">
        <div class="addr-line">
          <MapPin size={22} color="var(--c-master)" />
          <div class="addr-text">
            <span class="addr-label">ENDEREÇO</span>
            <span class="addr-value">Av. Pres. Tancredo Neves, 2337 - Castelo, Belo Horizonte - MG, 31330-472</span>
          </div>
        </div>
        <div class="addr-line">
          <Clock size={22} color="var(--c-master)" />
          <div class="addr-text">
            <span class="addr-label">HORÁRIO</span>
            <span class="addr-value">Seg–Sex 9h–19h · Sáb 9h–14h · Dom fechado</span>
          </div>
        </div>
        <div class="addr-line">
          <Phone size={22} color="var(--c-master)" />
          <div class="addr-text">
            <span class="addr-label">WHATSAPP</span>
            <span class="addr-phone">(31) 98979-5391</span>
          </div>
        </div>
      </div>

      <div class="loc-btns">
        <a href="https://www.google.com/maps?vet=10CAAQoqAOahcKEwiYkbWNgKqUAxUAAAAAHQAAAAAQCQ..i&sca_esv=9b0cec2fe7cd0d24&pvq=Cg0vZy8xMXJ0eWticWgwIhQKDnZ3IHN1cGxlbWVudG9zEAIYAw&lqi=Chh2dyBzdXBsZW1lbnRvcyBlbmRlcmXDp28iAkgBSOCz1djnt4CACFoYEAAQARgAGAEiDnZ3IHN1cGxlbWVudG9zkgEddml0YW1pbl9hbmRfc3VwcGxlbWVudHNfc3RvcmU&fvr=1&cs=1&um=1&ie=UTF-8&fb=1&gl=br&sa=X&ftid=0xa69108f4ed16e3:0x90cd24d786c2c9be" class="loc-btn outline" target="_blank" rel="noopener noreferrer">
          <Map size={16} />
          <span>VER NO GOOGLE MAPS</span>
        </a>
        <a href={whatsappLink} class="loc-btn filled" target="_blank" rel="noopener noreferrer">
          <MessageCircle size={16} />
          <span>CHAMAR NO WHATSAPP</span>
        </a>
      </div>
    </div>

    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3752.126462497645!2d-43.99642592395568!3d-19.887413681489625!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xa69108f4ed16e3%3A0x90cd24d786c2c9be!2sVW%20suplementos!5e0!3m2!1spt-BR!2sbr!4v1715180000000!5m2!1spt-BR!2sbr"
      width="100%"
      height="450"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      title="Localização da VW Suplementos"
    ></iframe>
  </div>
</section>

<style>
  .localizacao {
    background: var(--c-paper);
    border-top: 1px solid var(--c-line);
    width: 100%;
  }

  .loc-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 4vw, 64px);
    padding: var(--section-y) var(--gutter);
  }

  .loc-left {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2vw, 24px);
  }

  .loc-kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
    color: var(--c-muted);
  }

  .loc-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 68px);
    font-weight: 800;
    font-style: italic;
    line-height: 0.95;
    letter-spacing: -2px;
    color: var(--c-ink);
  }

  .addr-block {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 16px;
  }

  .addr-line {
    display: flex;
    gap: 14px;
    transition: transform var(--t-med) var(--ease-out);
  }
  .addr-line:hover { transform: translateX(4px); }

  .addr-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .addr-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--c-muted);
  }

  .addr-value {
    font-family: var(--font-ui);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--c-ink);
  }

  .addr-phone {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--c-ink);
  }

  .loc-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }

  .loc-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--c-ink);
    transition: transform var(--t-med) var(--ease-out), background var(--t-fast) var(--ease-out), box-shadow var(--t-med) var(--ease-out);
  }

  .loc-btn:hover {
    transform: translateY(-2px);
  }

  .loc-btn.outline {
    border: 2px solid var(--c-ink);
    background: transparent;
  }
  .loc-btn.outline:hover { background: var(--c-ink); color: var(--c-paper); }

  .loc-btn.filled {
    background: var(--c-master);
  }
  .loc-btn.filled:hover { box-shadow: 0 12px 26px -10px rgba(245, 195, 0, 0.55); }

  .map-placeholder {
    position: relative;
    width: 100%;
    min-height: 420px;
    aspect-ratio: 5 / 4;
    max-height: 560px;
    background: var(--c-mid);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 30px 80px -40px rgba(10, 10, 9, 0.4);
  }

  .grid-h {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: #F5F0E81A;
  }

  .grid-v {
    position: absolute;
    top: 0;
    height: 100%;
    width: 1px;
    background: #F5F0E81A;
  }

  .road-h {
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 6px;
    background: #0A0A0959;
    transform: translateY(-50%);
  }

  .road-v {
    position: absolute;
    left: 50%;
    top: 0;
    width: 6px;
    height: 100%;
    background: #0A0A0959;
    transform: translateX(-50%);
  }

  .pin {
    position: absolute;
    left: 50%;
    top: 45%;
    transform: translate(-50%, -50%);
    animation: floatY 3.5s var(--ease-in-out) infinite;
  }

  .pin-head {
    width: 48px;
    height: 48px;
    background: var(--c-master);
    border-radius: var(--radius-pill);
    border: 3px solid var(--c-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: pulseDot 2.4s var(--ease-in-out) infinite;
  }

  .pin-shadow {
    position: absolute;
    left: 50%;
    top: calc(45% + 30px);
    width: 16px;
    height: 6px;
    background: #0A0A0959;
    border-radius: var(--radius-pill);
    transform: translateX(-50%);
    filter: blur(2px);
  }

  .map-badge {
    position: absolute;
    top: 24px;
    left: 24px;
    background: var(--c-paper);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    box-shadow: 0 8px 18px -6px rgba(0,0,0,0.25);
  }

  .map-badge span {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--c-ink);
  }

  @media (max-width: 900px) {
    .loc-inner { grid-template-columns: 1fr; }
    .loc-btns { flex-direction: column; }
    .loc-btn { justify-content: center; }
    .map-placeholder { min-height: 320px; aspect-ratio: 16 / 11; }
  }
</style>
