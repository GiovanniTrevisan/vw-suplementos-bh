---
import { Image } from 'astro:assets';
import { MessageCircle } from '@lucide/astro';
import { WHATSAPP_NUMBER } from '../lib/config';
import { buildWhatsAppLink } from '../lib/format';
import logoDark from '../assets/logo_dark.webp';

const whatsappLink = buildWhatsAppLink(WHATSAPP_NUMBER, 'Olá! Gostaria de mais informações sobre os produtos da VW Suplementos.');
const base = import.meta.env.BASE_URL;
---

<footer class="footer">
  <div class="footer-inner container">
    <div class="footer-top">
      <div class="fc fc1">
        <div class="f-logo">
          <Image src={logoDark} alt="VW Suplementos" class="logo-img" loading="lazy" decoding="async" style="max-width:200px; height:auto;" />
        </div>
        <p class="f-tag">Loja física no Castelo, BH. Suplementos originais, atendimento técnico e entrega rápida na Grande BH.</p>
        <div class="f-social">
          <a href="https://www.instagram.com/vwsuplementosbh" class="social-btn" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--c-paper)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
          <a href={whatsappLink} class="social-btn" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
            <MessageCircle size={18} color="var(--c-paper)" />
          </a>
        </div>
      </div>

      <div class="fc fc2">
        <span class="fc-title">// NAVEGAR</span>
        <a href={`${base}catalogo`}>Catálogo</a>
        <a href={`${base}#sobre`}>Sobre nós</a>
        <a href={`${base}#localizacao`}>Localização</a>
        <a href={`${base}politica-de-privacidade`}>Política de privacidade</a>
      </div>

      <div class="fc fc3">
        <span class="fc-title">// CONTATO</span>
        <p class="fc-addr">Av. Pres. Tancredo Neves, 2337 — Loja 8<br/>Castelo, Belo Horizonte/MG</p>
        <a href={whatsappLink} class="fc-wa" target="_blank" rel="noopener noreferrer">WhatsApp: (31) 98979-5391</a>
        <span class="fc-email">contato@vwsuplementos.com.br</span>
      </div>

      <div class="fc fc4">
        <span class="fc-title">// HORÁRIO</span>
        <div class="hrs-row">
          <span class="hrs-label">SEG–SEX</span>
          <span class="hrs-value">9h–20h</span>
        </div>
        <div class="hrs-row">
          <span class="hrs-label">SÁBADO</span>
          <span class="hrs-value">9h–14h</span>
        </div>
        <div class="hrs-row">
          <span class="hrs-label">DOMINGO</span>
          <span class="hrs-value closed">FECHADO</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© 2026 VW SUPLEMENTOS · CNPJ 38.038.336/0001-16 · TODOS OS DIREITOS RESERVADOS</span>
      <a href="https://trevizzosolucoes.com.br/" target="_blank" rel="noopener noreferrer">PÁGINA FEITA POR TREVIZZO SOLUÇÕES</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-surface);
    width: 100%;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(36px, 4vw, 60px);
    padding: clamp(48px, 6vw, 80px) var(--gutter) 28px;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr 1fr;
    gap: clamp(28px, 4vw, 64px);
  }

  .fc {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .fc1 { gap: 20px; }

  .f-logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .f-tag {
    color: var(--c-paper-muted);
    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.6;
  }

  .f-social {
    display: flex;
    gap: 12px;
    padding-top: 4px;
  }

  .social-btn {
    width: 40px;
    height: 40px;
    background: var(--c-mid);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--t-med) var(--ease-out), background var(--t-fast) var(--ease-out);
  }

  .social-btn:hover {
    background: var(--c-master);
    transform: translateY(-3px) rotate(-4deg);
  }
  .social-btn:hover :global(svg) { color: var(--c-ink); }

  .fc-title {
    color: var(--c-master);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
  }

  .fc2 a {
    color: var(--c-paper-muted);
    font-family: var(--font-ui);
    font-size: 14px;
    transition: color var(--t-fast) var(--ease-out), padding-left var(--t-med) var(--ease-out);
  }

  .fc2 a:hover {
    color: var(--c-paper);
    padding-left: 4px;
  }

  .fc-addr {
    color: var(--c-paper-muted);
    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.6;
  }

  .fc-wa {
    color: var(--c-paper);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: color var(--t-fast) var(--ease-out);
  }

  .fc-wa:hover {
    color: var(--c-master);
  }

  .fc-email {
    color: var(--c-paper-muted);
    font-family: var(--font-mono);
    font-size: 13px;
    word-break: break-all;
  }

  .hrs-row {
    display: flex;
    justify-content: space-between;
  }

  .hrs-label {
    color: var(--c-paper-muted);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 1px;
  }

  .hrs-value {
    color: var(--c-paper);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
  }

  .hrs-value.closed {
    color: var(--c-red);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--c-line-on-dark);
    flex-wrap: wrap;
  }

  .footer-bottom span,
  .footer-bottom a {
    color: var(--c-paper-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    text-decoration: none;
    transition: color var(--t-fast) var(--ease-out);
  }

  .footer-bottom a:hover {
    color: var(--c-master);
  }

  @media (max-width: 900px) {
    .footer-top { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 540px) {
    .footer-top { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; text-align: center; }
  }
</style>
