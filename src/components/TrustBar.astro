---
const stats = [
  { value: '5+', label: 'anos de experiência', highlight: false },
  { value: '4,7★', label: 'avaliação no Google', highlight: true },
  { value: '7', label: 'lojas em MG e PR', highlight: false },
  { value: '100%', label: 'Whey, creatina e pré das principais marcas', highlight: false },
];
---

<section class="trust-bar">
  <div class="trust-inner container" data-reveal-stagger>
    {stats.map((stat, i) => (
      <>
        {i > 0 && <div class="divider" aria-hidden="true" />}
        <div class="stat">
          <span class:list={['stat-value', { yellow: stat.highlight }]}>{stat.value}</span>
          <span class="stat-label">{stat.label}</span>
        </div>
      </>
    ))}
  </div>
</section>

<style>
  .trust-bar {
    background: var(--c-ink);
    width: 100%;
  }

  .trust-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: clamp(20px, 3vw, 40px);
    padding: clamp(32px, 4vw, 48px) var(--gutter);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: transform var(--t-med) var(--ease-out);
  }

  .stat:hover { transform: translateY(-3px); }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 800;
    font-style: italic;
    line-height: 0.9;
    letter-spacing: -2px;
    color: var(--c-paper);
  }

  .stat-value.yellow {
    color: var(--c-yellow);
  }

  .stat-label {
    font-family: var(--font-ui);
    font-size: 13px;
    color: #F5F0E8B3;
    line-height: 1.4;
  }

  .divider {
    width: 1px;
    height: 80px;
    background: #F5F0E833;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .trust-inner {
      grid-template-columns: 1fr 1fr;
      gap: 24px 16px;
    }
    .divider { display: none; }
  }
</style>
