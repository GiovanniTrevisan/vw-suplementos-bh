---
import { ArrowRight } from '@lucide/astro';
---

<section class="categorias">
  <div class="cats-inner container">
    <div class="cats-header" data-reveal>
      <div class="cats-title-wrap">
        <span class="cats-kicker">CATEGORIAS</span>
        <h2 class="cats-title">EM DESTAQUE.</h2>
      </div>
      <a href="/catalogo" class="cats-link">
        <span>VER TUDO</span>
        <ArrowRight size={16} />
      </a>
    </div>

    <div data-cats-loading class="cats-loading">
      <div class="loader"></div>
    </div>

    <div class="cats-grid" data-cats-grid hidden></div>

    <div class="cats-empty" data-cats-empty hidden>
      <span>Nenhuma categoria cadastrada na planilha ainda.</span>
    </div>
  </div>
</section>

<script>
  import { fetchCatalog } from '../lib/api';

  const grid    = document.querySelector<HTMLElement>('[data-cats-grid]')!;
  const loading = document.querySelector<HTMLElement>('[data-cats-loading]')!;
  const empty   = document.querySelector<HTMLElement>('[data-cats-empty]')!;

  // Ícones inline (mesma família visual usada na home)
  const ICONS = [
    // dumbbell
    `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6.5 6.5 11 11"/><path d="m21 21-1-1"/><path d="m3 3 1 1"/><path d="m18 22 4-4"/><path d="m2 6 4-4"/><path d="m3 10 7-7"/><path d="m14 21 7-7"/></svg>`,
    // flame
    `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>`,
    // heart-pulse
    `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/></svg>`,
    // cup-soda
    `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 8 1.75 12.28a2 2 0 0 0 2 1.72h4.54a2 2 0 0 0 2-1.72L18 8"/><path d="M5 8h14"/><path d="M7 15a6.47 6.47 0 0 1 5 0 6.47 6.47 0 0 0 5 0"/><path d="m12 8 1-6h2"/></svg>`,
    // package
    `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="m7.5 4.27 9 5.15"/></svg>`,
    // pill
    `<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"/><path d="m8.5 8.5 7 7"/></svg>`,
  ];

  const ARROW = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`;

  function pluralize(n: number) {
    return n === 1 ? '1 produto' : `${n} produtos`;
  }

  async function load() {
    const data = await fetchCatalog();
    loading.hidden = true;

    if (!data.ok || !data.categories.length) {
      empty.hidden = false;
      return;
    }

    const top = data.categories.slice(0, 4);
    grid.innerHTML = '';
    top.forEach((c, i) => {
      const a = document.createElement('a');
      // Segundo card (índice 1) é destacado em amarelo conforme o design.
      a.className = 'cat-card';
      a.href = `/catalogo?categoria=${encodeURIComponent(c.name)}`;
      a.innerHTML = `
        <div class="cat-icon">${ICONS[i % ICONS.length]}</div>
        <div class="cat-bot">
          <div class="cat-info">
            <span class="cat-title"></span>
            <span class="cat-sub"></span>
          </div>
          <span class="cat-arrow">${ARROW}</span>
        </div>
      `;
      (a.querySelector('.cat-title')!).textContent = c.name.toUpperCase();
      (a.querySelector('.cat-sub')!).textContent = pluralize(c.count);
      grid.appendChild(a);
    });
    grid.hidden = false;
  }

  load();
</script>

<style>
  .categorias {
    background: var(--c-paper);
    width: 100%;
  }

  .cats-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 3vw, 48px);
    padding: var(--section-y) var(--gutter);
  }

  .cats-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }

  .cats-title-wrap { display: flex; flex-direction: column; gap: 12px; }
  .cats-kicker {
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    letter-spacing: 2px; color: var(--c-muted);
  }
  .cats-title {
    font-family: var(--font-display); font-size: clamp(40px, 6vw, 80px);
    font-weight: 800; font-style: italic; line-height: 0.9;
    letter-spacing: -2px; color: var(--c-ink);
  }
  .cats-link {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-display); font-size: 14px; font-weight: 800;
    letter-spacing: 1px; color: var(--c-ink);
    transition: gap var(--t-med) var(--ease-out), opacity var(--t-fast) var(--ease-out);
  }
  .cats-link:hover { gap: 14px; opacity: 0.85; }

  .cats-loading {
    display: flex; align-items: center; justify-content: center;
    min-height: 240px;
  }
  .cats-empty {
    padding: 32px; text-align: center;
    font-family: var(--font-ui); font-size: 14px; color: var(--c-muted);
    border: 1px dashed var(--c-line-hard); border-radius: var(--radius-md);
  }
</style>

<!--
  Estilos abaixo são GLOBAIS porque os cards são criados via JS em runtime.
  Astro só aplica o scope (data-astro-cid-*) em elementos do template estático,
  então classes adicionadas via `el.className = ...` ficariam sem estilo.
-->
<style is:global>
  .cats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(12px, 1.2vw, 20px);
  }

  .cat-card {
    position: relative;
    display: flex; flex-direction: column;
    justify-content: space-between;
    height: clamp(240px, 24vw, 320px);
    padding: 28px 24px;
    border-radius: var(--radius-md);
    background: var(--c-mid);
    color: var(--c-paper);
    overflow: hidden;
    transition:
      transform var(--t-med) var(--ease-out),
      box-shadow var(--t-med) var(--ease-out),
      background var(--t-med) var(--ease-out),
      color var(--t-med) var(--ease-out);
  }

  .cat-card::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.08), transparent 50%);
    opacity: 0;
    transition: opacity var(--t-med) var(--ease-out);
    pointer-events: none;
  }

  .cat-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -16px rgba(10, 10, 9, 0.3);
    background: var(--c-yellow);
    color: var(--c-ink);
  }
  .cat-card:hover::before { opacity: 1; }
  .cat-card:hover .cat-icon { color: var(--c-ink); }
  .cat-card:hover .cat-sub { color: rgba(10, 10, 9, 0.7); }

  /* Card destacado (segundo do grid no design) */
  .cat-card.featured {
    background: var(--c-yellow);
    color: var(--c-ink);
  }
  .cat-card.featured .cat-icon { color: var(--c-ink); }
  .cat-card.featured .cat-sub { color: rgba(10, 10, 9, 0.7); }

  .cat-icon {
    position: relative;
    color: var(--c-yellow);
    transition: transform var(--t-med) var(--ease-out), color var(--t-med) var(--ease-out);
  }
  .cat-icon svg { display: block; }
  .cat-card:hover .cat-icon { transform: scale(1.08) rotate(-4deg); }

  .cat-bot {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
  }
  .cat-info {
    display: flex; flex-direction: column; gap: 6px;
    min-width: 0;
  }
  .cat-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 1.9vw, 30px);
    font-weight: 700;
    letter-spacing: -1px;
    line-height: 1.05;
  }
  .cat-sub {
    font-family: var(--font-ui);
    font-size: 13px;
    color: rgba(245, 240, 232, 0.7);
    transition: color var(--t-med) var(--ease-out);
  }

  .cat-arrow {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    transition: transform var(--t-med) var(--ease-out);
  }
  .cat-arrow svg { display: block; }
  .cat-card:hover .cat-arrow { transform: translateX(6px); }

  @media (max-width: 720px) { .cats-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 420px) { .cats-grid { grid-template-columns: 1fr; } }
</style>
