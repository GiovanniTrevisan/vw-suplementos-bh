---
import { Dumbbell, Flame, HeartPulse, ArrowRight, CupSoda } from '@lucide/astro';

const categories = [
  { icon: 'dumbbell',    title: 'PROTEÍNAS',         subtitle: 'Whey, caseína, vegetal',     bg: 'dark' },
  { icon: 'flame',       title: 'CREATINA & PRÉ',    subtitle: 'Energia e força',            bg: 'dark' },
  { icon: 'heart-pulse', title: 'VITAMINAS & SAÚDE', subtitle: 'Multivitamínicos, ômega',    bg: 'dark' },
  { icon: 'shaker',      title: 'ACESSÓRIOS',        subtitle: 'Coqueteleiras, luvas, cintos', bg: 'dark' },
];
---

<section class="categorias">
  <div class="cats-inner container">
    <div class="cats-header" data-reveal>
      <div class="cats-title-wrap">
        <span class="cats-kicker">CATEGORIAS</span>
        <h2 class="cats-title">EM DESTAQUE.</h2>
      </div>
      <a href="/catalogo" class="cats-link">
        <span>VER TUDO</span>
        <ArrowRight size={16} />
      </a>
    </div>

    <div class="cats-grid" data-reveal-stagger>
      {categories.map((cat) => (
        <a href="/catalogo" class:list={['cat-card', cat.bg]}>
          <div class="cat-top">
            {cat.icon === 'dumbbell' && <Dumbbell size={48} />}
            {cat.icon === 'flame' && <Flame size={48} />}
            {cat.icon === 'heart-pulse' && <HeartPulse size={48} />}
            {cat.icon === 'shaker' && <CupSoda size={48} />}
            <span class="cat-title">{cat.title}</span>
            <span class="cat-sub">{cat.subtitle}</span>
          </div>
          <div class="cat-bot">
            <ArrowRight size={24} />
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .categorias {
    background: var(--c-paper);
    width: 100%;
  }

  .cats-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 3vw, 48px);
    padding: var(--section-y) var(--gutter);
  }

  .cats-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }

  .cats-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cats-kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
    color: var(--c-muted);
  }

  .cats-title {
    font-family: var(--font-display);
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 800;
    font-style: italic;
    line-height: 0.9;
    letter-spacing: -2px;
    color: var(--c-ink);
  }

  .cats-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--c-ink);
    transition: gap var(--t-med) var(--ease-out), opacity var(--t-fast) var(--ease-out);
  }

  .cats-link:hover { gap: 14px; opacity: 0.85; }

  .cats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(12px, 1.2vw, 20px);
  }

  .cat-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: clamp(240px, 24vw, 320px);
    padding: 24px;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--t-med) var(--ease-out), box-shadow var(--t-med) var(--ease-out);
  }

  .cat-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.08), transparent 50%);
    opacity: 0;
    transition: opacity var(--t-med) var(--ease-out);
  }

  .cat-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -16px rgba(10, 10, 9, 0.3);
  }
  .cat-card:hover::before { opacity: 1; }
  /* Hover to yellow with smooth transition */
  .cat-card:hover {
    background: var(--c-yellow) !important;
    color: var(--c-ink) !important;
    transition: background var(--t-med) var(--ease-out), color var(--t-med) var(--ease-out), transform var(--t-med) var(--ease-out), box-shadow var(--t-med) var(--ease-out);
  }
  .cat-card:hover .cat-top :global(svg) {
    color: var(--c-ink) !important;
  }
  .cat-card:hover .cat-sub {
    color: var(--c-ink) !important;
  }

  .cat-card.dark {
    background: var(--c-mid);
    color: var(--c-paper);
  }

  .cat-card.dark .cat-top :global(svg) { color: var(--c-yellow); }
  .cat-card.dark .cat-sub { color: var(--c-ui-soft); }

  .cat-card.yellow {
    background: var(--c-yellow);
    color: var(--c-ink);
  }

  .cat-card.yellow .cat-top :global(svg) { color: var(--c-ink); }
  .cat-card.yellow .cat-sub { color: var(--c-ink); }

  .cat-top {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .cat-top :global(svg) {
    transition: transform var(--t-med) var(--ease-out);
  }

  .cat-card:hover .cat-top :global(svg) {
    transform: scale(1.1) rotate(-4deg);
  }

  .cat-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 1.9vw, 30px);
    font-weight: 700;
    letter-spacing: -1px;
  }

  .cat-sub {
    font-family: var(--font-ui);
    font-size: 13px;
  }

  .cat-bot {
    position: relative;
    display: flex;
    justify-content: flex-end;
  }

  .cat-bot :global(svg) {
    transition: transform var(--t-med) var(--ease-out);
  }
  .cat-card:hover .cat-bot :global(svg) {
    transform: translateX(6px);
  }

  @media (max-width: 720px) {
    .cats-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 420px) {
    .cats-grid { grid-template-columns: 1fr; }
  }
</style>
