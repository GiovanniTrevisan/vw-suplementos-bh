     ============================================================ */
  @media (max-width: 900px) {
    /* Layout principal: produtos ocupam toda a largura */
    .main-area {
      grid-template-columns: 1fr;
      padding: clamp(16px, 3vw, 28px) var(--gutter) clamp(28px, 4vw, 48px);
    }

    /* Title block: alinhamento mais vertical no mobile */
