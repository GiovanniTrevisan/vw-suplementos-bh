---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ChevronDown, X, Search, SlidersHorizontal } from '@lucide/astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Catálogo — VW Suplementos BH">
  <Header />

  <div class="breadcrumb-wrap">
    <div class="breadcrumb container">
      <a href={base}>INÍCIO</a>
      <span>›</span>
      <span class="active">CATÁLOGO</span>
    </div>
  </div>

  <div class="divider"></div>

  <div class="title-block container" data-reveal>
    <div class="title-left">
      <span class="title-kicker">// CATÁLOGO COMPLETO</span>
      <h1 class="title-heading">TODOS OS PRODUTOS</h1>
      <p class="title-sub">Whey, creatina, pré-treino e mais. Os melhores suplementos com entrega para toda a Grande BH.</p>
    </div>
    <div class="results-count">
      <span class="results-label">RESULTADOS</span>
      <span class="results-number" data-results-count>0</span>
      <span class="results-text">produtos encontrados</span>
    </div>
  </div>

  <div class="mobile-toolbar" data-mobile-toolbar>
    <button class="mobile-filter-btn" type="button" data-open-filters aria-label="Abrir filtros">
      <SlidersHorizontal size={16} />
      <span>FILTROS</span>
      <span class="mobile-filter-badge" data-mobile-filter-count hidden>0</span>
    </button>
    <div class="mobile-sort-wrap">
      <select class="mobile-sort-select" data-mobile-sort aria-label="Ordenar produtos">
        <option value="default">Mais vendidos</option>
        <option value="price-asc">Menor preço</option>
        <option value="price-desc">Maior preço</option>
        <option value="name-asc">Nome (A → Z)</option>
        <option value="name-desc">Nome (Z → A)</option>
      </select>
    </div>
  </div>

  <div class="main-area container">
    <aside class="sidebar" data-sidebar>
      <div class="sb-header">
        <span class="sb-title">FILTROS</span>
        <span class="sb-count" data-active-filter-count>// 00</span>
        <button class="drawer-close-btn" type="button" data-close-filters aria-label="Fechar filtros">
          <X size={20} />
        </button>
      </div>

      <div class="sb-body">
        <div class="filter-section">
          <div class="filter-head">
            <span>BUSCA</span>
            <Search size={14} />
          </div>
          <div class="search-wrap">
            <input type="search" data-search placeholder="Buscar por nome..." class="search-input" />
          </div>
        </div>

        <div class="filter-divider"></div>

        <div class="filter-section">
          <button class="filter-head filter-head-toggle" type="button" data-cat-toggle aria-expanded="false">
            <span>CATEGORIA</span>
            <ChevronDown size={14} class="cat-chevron" />
          </button>
          <div class="filter-pills" data-category-pills></div>
        </div>

        <div class="filter-divider"></div>

        <div class="filter-section">
          <div class="filter-head">
            <span>FAIXA DE PREÇO</span>
          </div>
          <div class="filter-pills" data-price-pills></div>
        </div>

        <div class="filter-divider"></div>

        <div class="filter-section">
          <div class="filter-head">
            <span>ORDENAR POR</span>
          </div>
          <div class="select-wrap">
            <select class="sort-select" data-sort>
              <option value="default">Mais vendidos</option>
              <option value="price-asc">Menor preço</option>
              <option value="price-desc">Maior preço</option>
              <option value="name-asc">Nome (A → Z)</option>
              <option value="name-desc">Nome (Z → A)</option>
            </select>
          </div>
        </div>

        <div class="filter-divider clear-link-divider"></div>

        <div class="clear-link" data-clear-filters>
          <X size={12} />
          <span>Limpar filtros</span>
        </div>
      </div>

      <div class="drawer-footer">
        <button class="drawer-clear-btn" type="button" data-drawer-clear>
          <X size={14} />
          <span>LIMPAR</span>
        </button>
        <button class="drawer-apply-btn" type="button" data-close-filters>
          <span>VER <span data-drawer-result-count>0</span> PRODUTOS</span>
        </button>
      </div>
    </aside>

    <div class="grid-area">
      <div class="active-filters" data-active-filters></div>

      <div data-state-loading class="state-block">
        <div class="loader"></div>
        <span>Carregando catálogo...</span>
      </div>

      <div data-state-error class="state-block error" hidden>
        <span class="state-title">Não foi possível carregar o catálogo.</span>
        <span class="state-msg" data-error-msg></span>
        <button class="btn-retry" data-retry>Tentar novamente</button>
      </div>

      <div data-state-empty class="state-block" hidden>
        <span class="state-title">Nenhum produto encontrado.</span>
        <span>Tente outra busca ou remova os filtros.</span>
      </div>

      <div class="product-grid" data-product-grid hidden></div>

      <div class="pagination" data-pagination hidden>
        <button class="load-more" type="button" data-load-more>
          <span>CARREGAR MAIS PRODUTOS</span>
        </button>
        <span class="pagination-info" data-pagination-info></span>
      </div>
    </div>
  </div>

  <div class="drawer-backdrop" data-drawer-backdrop aria-hidden="true"></div>

  <Footer />
  <Fragment set:html={`<script type="application/ld+json">${JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Início", "item": "https://vwsuplementosbh.com.br/" },
      { "@type": "ListItem", "position": 2, "name": "Catálogo", "item": "https://vwsuplementosbh.com.br/catalogo" }
    ]
  })}</script>`} />
</Layout>

<script>
  import { fetchCatalog } from '../lib/api';
  import type { Product, CategoryInfo } from '../lib/api';
  import { cart } from '../lib/cart';
  import { formatBRL } from '../lib/format';

  const grid       = document.querySelector<HTMLElement>('[data-product-grid]')!;
  const pillsBox   = document.querySelector<HTMLElement>('[data-category-pills]')!;
  const catToggle  = document.querySelector<HTMLButtonElement>('[data-cat-toggle]');
  const pricePills = document.querySelector<HTMLElement>('[data-price-pills]')!;
  const sortSel    = document.querySelector<HTMLSelectElement>('[data-sort]')!;
  const searchEl   = document.querySelector<HTMLInputElement>('[data-search]')!;
  const countEl    = document.querySelector<HTMLElement>('[data-results-count]')!;
  const filterCnt  = document.querySelector<HTMLElement>('[data-active-filter-count]')!;
  const activeBox  = document.querySelector<HTMLElement>('[data-active-filters]')!;
  const stateLoad  = document.querySelector<HTMLElement>('[data-state-loading]')!;
  const stateErr   = document.querySelector<HTMLElement>('[data-state-error]')!;
  const stateEmpty = document.querySelector<HTMLElement>('[data-state-empty]')!;
  const errMsg     = document.querySelector<HTMLElement>('[data-error-msg]')!;
  const retryBtn   = document.querySelector<HTMLButtonElement>('[data-retry]')!;
  const clearBtn   = document.querySelector<HTMLElement>('[data-clear-filters]')!;
  const pagination = document.querySelector<HTMLElement>('[data-pagination]')!;
  const loadMore   = document.querySelector<HTMLButtonElement>('[data-load-more]')!;
  const pagInfo    = document.querySelector<HTMLElement>('[data-pagination-info]')!;

  // Mobile drawer / toolbar
  const sidebarEl   = document.querySelector<HTMLElement>('[data-sidebar]')!;
  const backdropEl  = document.querySelector<HTMLElement>('[data-drawer-backdrop]')!;
  const openFilters = document.querySelector<HTMLButtonElement>('[data-open-filters]')!;
  const closeFiltersBtns = document.querySelectorAll<HTMLButtonElement>('[data-close-filters]');
  const drawerClearBtn   = document.querySelector<HTMLButtonElement>('[data-drawer-clear]')!;
  const mobileSortSel    = document.querySelector<HTMLSelectElement>('[data-mobile-sort]')!;
  const mobileFilterCnt  = document.querySelector<HTMLElement>('[data-mobile-filter-count]')!;
  const drawerCountEl    = document.querySelector<HTMLElement>('[data-drawer-result-count]')!;

  type SortKey = 'default' | 'price-asc' | 'price-desc' | 'name-asc' | 'name-desc';

  const PRICE_RANGES: ReadonlyArray<{ id: string; label: string; min: number; max: number }> = [
    { id: '',        label: 'Todos',             min: -Infinity, max: Infinity },
    { id: '0-50',    label: 'R$ 0 – R$ 50',      min: 0,         max: 50 },
    { id: '50-100',  label: 'R$ 50 – R$ 100',    min: 50,        max: 100 },
    { id: '100-200', label: 'R$ 100 – R$ 200',   min: 100,       max: 200 },
    { id: '200+',    label: 'Acima de R$ 200',   min: 200,       max: Infinity },
  ];
  const PAGE_SIZE = 12;
  const CATEGORY_COLLAPSED_COUNT = 0;

  let allProducts: Product[] = [];
  let categories: CategoryInfo[] = [];
  let activeCategory = '';
  let activePrice = '';
  let sortBy: SortKey = 'default';
  let searchTerm = '';
  let visibleCount = PAGE_SIZE;
  let categoriesExpanded = false;

  // Aceita ?categoria=Nome via URL
  const urlParams = new URLSearchParams(location.search);
  const initialCat = urlParams.get('categoria') || '';

  function priceRangeLabel(id: string) {
    return PRICE_RANGES.find((r) => r.id === id)?.label || '';
  }

  function activeFilterCount(): number {
    return (activeCategory ? 1 : 0) + (searchTerm ? 1 : 0) + (activePrice ? 1 : 0);
  }

  function renderActiveFilters() {
    const n = activeFilterCount();
    filterCnt.textContent = `// ${String(n).padStart(2, '0')}`;

    if (n > 0) {
      mobileFilterCnt.textContent = String(n);
      mobileFilterCnt.hidden = false;
    } else {
      mobileFilterCnt.hidden = true;
    }

    activeBox.innerHTML = '';
    if (n === 0) return;

    const label = document.createElement('span');
    label.className = 'af-label';
    label.textContent = 'FILTROS ATIVOS:';
    activeBox.appendChild(label);

    if (activeCategory) {
      activeBox.appendChild(makeTag(activeCategory, () => selectCategory('')));
    }
    if (activePrice) {
      activeBox.appendChild(makeTag(priceRangeLabel(activePrice), () => selectPrice('')));
    }
    if (searchTerm) {
      activeBox.appendChild(
        makeTag(`Busca: "${searchTerm}"`, () => {
          searchEl.value = '';
          searchTerm = '';
          resetPaging();
          render();
        })
      );
    }
  }

  function makeTag(label: string, onClose: () => void): HTMLElement {
    const tag = document.createElement('div');
    tag.className = 'af-tag';
    tag.innerHTML = `<span></span><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>`;
    tag.querySelector('span')!.textContent = label;
    tag.addEventListener('click', onClose);
    return tag;
  }

  function renderCategoryPills() {
    pillsBox.innerHTML = '';
    const total = allProducts.length;

    const todos = document.createElement('div');
    todos.className = 'pill' + (activeCategory === '' ? ' active' : '');
    todos.innerHTML = `<span>Todos</span><span class="pill-count">${total}</span>`;
    todos.addEventListener('click', () => selectCategory(''));
    pillsBox.appendChild(todos);

    // Quando recolhido, mostra apenas os primeiros N — garantindo que a
    // categoria ativa apareça mesmo se estiver fora da faixa visível.
    let visibleCategories = categories;
    if (!categoriesExpanded && categories.length > CATEGORY_COLLAPSED_COUNT) {
      visibleCategories = categories.slice(0, CATEGORY_COLLAPSED_COUNT);
      const activeIdx = categories.findIndex((c) => c.name === activeCategory);
      if (activeIdx >= CATEGORY_COLLAPSED_COUNT) {
        visibleCategories = [...visibleCategories, categories[activeIdx]];
      }
    }

    visibleCategories.forEach((c) => {
      const el = document.createElement('div');
      el.className = 'pill' + (c.name === activeCategory ? ' active' : '');
      el.innerHTML = `<span></span><span class="pill-count">${c.count}</span>`;
      (el.querySelector('span')!).textContent = c.name;
      el.addEventListener('click', () => selectCategory(c.name));
      pillsBox.appendChild(el);
    });

    updateCategoryToggle();
  }

  function updateCategoryToggle() {
    if (!catToggle) return;
    const hasMore = categories.length > CATEGORY_COLLAPSED_COUNT;
    catToggle.classList.toggle('no-toggle', !hasMore);
    catToggle.classList.toggle('expanded', categoriesExpanded);
    catToggle.disabled = !hasMore;
    catToggle.setAttribute('aria-expanded', String(categoriesExpanded));
  }

  function renderPricePills() {
    pricePills.innerHTML = '';
    PRICE_RANGES.forEach((r) => {
      const el = document.createElement('div');
      el.className = 'pill' + (activePrice === r.id ? ' active' : '');
      el.innerHTML = `<span></span>`;
      (el.querySelector('span')!).textContent = r.label;
      el.addEventListener('click', () => selectPrice(r.id));
      pricePills.appendChild(el);
    });
  }

  function selectCategory(name: string) {
    activeCategory = name;
    const url = new URL(location.href);
    if (name) url.searchParams.set('categoria', name);
    else url.searchParams.delete('categoria');
    history.replaceState(null, '', url);
    renderCategoryPills();
    resetPaging();
    render();
  }

  function selectPrice(id: string) {
    activePrice = id;
    renderPricePills();
    resetPaging();
    render();
  }

  function resetPaging() {
    visibleCount = PAGE_SIZE;
  }

  function applyFilters(): Product[] {
    const term = searchTerm.trim().toLowerCase();
    const range = PRICE_RANGES.find((r) => r.id === activePrice) || PRICE_RANGES[0];

    let list = allProducts.filter((p) => {
      const matchCat = activeCategory ? p.categoria === activeCategory : true;
      const matchTerm = term ? p.nome.toLowerCase().includes(term) : true;
      const matchPrice = p.preco >= range.min && p.preco < (range.max === Infinity ? Infinity : range.max + 0.001);
      return matchCat && matchTerm && matchPrice;
    });

    switch (sortBy) {
      case 'price-asc':  list = [...list].sort((a, b) => a.preco - b.preco); break;
      case 'price-desc': list = [...list].sort((a, b) => b.preco - a.preco); break;
      case 'name-asc':   list = [...list].sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR')); break;
      case 'name-desc':  list = [...list].sort((a, b) => b.nome.localeCompare(a.nome, 'pt-BR')); break;
      default: /* keep API order (mais vendidos) */ break;
    }

    return list;
  }

  function render() {
    const list = applyFilters();

    countEl.textContent = String(list.length);
    drawerCountEl.textContent = String(list.length);
    renderActiveFilters();

    grid.innerHTML = '';

    if (list.length === 0) {
      grid.hidden = true;
      pagination.hidden = true;
      stateEmpty.hidden = false;
      return;
    }

    stateEmpty.hidden = true;
    grid.hidden = false;

    const slice = list.slice(0, visibleCount);
    slice.forEach((p) => grid.appendChild(productCard(p)));

    const hasMore = list.length > slice.length;
    pagination.hidden = false;
    loadMore.hidden = !hasMore;
    pagInfo.textContent = `Mostrando ${slice.length} de ${list.length} ${list.length === 1 ? 'produto' : 'produtos'}`;
  }

  function productCard(p: Product): HTMLElement {
    const a = document.createElement('a');
    a.className = 'product-card';
    a.href = `${import.meta.env.BASE_URL}produto?id=${encodeURIComponent(p.id)}`;
    const img = p.imagem
      ? `<img src="${p.imagem}" alt="" loading="lazy" />`
      : '';
    a.innerHTML = `
      <div class="product-img">${img}</div>
      <div class="product-body">
        <span class="product-cat"></span>
        <span class="product-name"></span>
        <span class="product-price"></span>
        <button class="product-btn" type="button" data-add>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          <span>ADICIONAR</span>
        </button>
      </div>
    `;
    (a.querySelector('.product-cat')!).textContent = (p.categoria || '').toUpperCase();
    (a.querySelector('.product-name')!).textContent = p.nome;
    (a.querySelector('.product-price')!).textContent = formatBRL(p.preco);
    a.querySelector<HTMLButtonElement>('[data-add]')!.addEventListener('click', (ev) => {
      ev.preventDefault();
      cart.add(p, 1);
      const btn = ev.currentTarget as HTMLButtonElement;
      const span = btn.querySelector('span')!;
      const original = span.textContent;
      span.textContent = 'ADICIONADO ✓';
      btn.classList.add('added');
      setTimeout(() => { span.textContent = original; btn.classList.remove('added'); }, 1200);
    });
    return a;
  }

  function showLoading() {
    stateLoad.hidden = false;
    stateErr.hidden = true;
    stateEmpty.hidden = true;
    grid.hidden = true;
    pagination.hidden = true;
  }

  function showError(msg: string) {
    stateLoad.hidden = true;
    stateErr.hidden = false;
    stateEmpty.hidden = true;
    grid.hidden = true;
    pagination.hidden = true;
    errMsg.textContent = msg;
  }

  async function load(force = false) {
    showLoading();
    const data = await fetchCatalog(force);
    stateLoad.hidden = true;
    if (!data.ok) {
      showError(data.error || 'Erro desconhecido.');
      return;
    }
    allProducts = data.products;
    categories = data.categories;

    if (initialCat && categories.some((c) => c.name === initialCat)) {
      activeCategory = initialCat;
    }

    renderCategoryPills();
    renderPricePills();
    resetPaging();
    render();
  }

  // Eventos
  let searchTimer: number | undefined;
  searchEl.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      searchTerm = searchEl.value;
      resetPaging();
      render();
    }, 120);
  });

  sortSel.addEventListener('change', () => {
    sortBy = sortSel.value as SortKey;
    mobileSortSel.value = sortSel.value;
    resetPaging();
    render();
  });

  mobileSortSel.addEventListener('change', () => {
    sortBy = mobileSortSel.value as SortKey;
    sortSel.value = mobileSortSel.value;
    resetPaging();
    render();
  });

  // Drawer open / close
  function openDrawer() {
    sidebarEl.classList.add('drawer-open');
    backdropEl.classList.add('drawer-open');
    document.body.classList.add('drawer-locked');
    sidebarEl.setAttribute('aria-modal', 'true');
    sidebarEl.setAttribute('role', 'dialog');
  }
  function closeDrawer() {
    sidebarEl.classList.remove('drawer-open');
    backdropEl.classList.remove('drawer-open');
    document.body.classList.remove('drawer-locked');
    sidebarEl.removeAttribute('aria-modal');
    sidebarEl.removeAttribute('role');
  }
  openFilters.addEventListener('click', openDrawer);
  backdropEl.addEventListener('click', closeDrawer);
  closeFiltersBtns.forEach((b) => b.addEventListener('click', closeDrawer));
  drawerClearBtn.addEventListener('click', () => clearBtn.click());
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sidebarEl.classList.contains('drawer-open')) closeDrawer();
  });

  catToggle?.addEventListener('click', () => {
    categoriesExpanded = !categoriesExpanded;
    renderCategoryPills();
  });

  retryBtn.addEventListener('click', () => load(true));

  clearBtn.addEventListener('click', () => {
    activeCategory = '';
    activePrice = '';
    sortBy = 'default';
    sortSel.value = 'default';
    mobileSortSel.value = 'default';
    searchTerm = '';
    searchEl.value = '';
    const url = new URL(location.href);
    url.searchParams.delete('categoria');
    history.replaceState(null, '', url);
    renderCategoryPills();
    renderPricePills();
    resetPaging();
    render();
  });

  loadMore.addEventListener('click', () => {
    visibleCount += PAGE_SIZE;
    render();
  });

  load();
</script>

<style>
  .breadcrumb-wrap { background: var(--c-paper); }
  .breadcrumb {
    display: flex; align-items: center; gap: 10px;
    padding: 18px var(--gutter);
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 1.5px; color: var(--c-muted);
  }
  .breadcrumb a { color: var(--c-muted); transition: color var(--t-fast) var(--ease-out); }
  .breadcrumb a:hover { color: var(--c-ink); }
  .breadcrumb .active { color: var(--c-ink); font-weight: 700; }
  .divider { height: 1px; background: var(--c-line); width: 100%; }

  .title-block {
    display: flex; justify-content: space-between; align-items: flex-end;
    padding: clamp(28px, 4vw, 56px) var(--gutter) clamp(24px, 3vw, 40px);
    gap: 32px; background: var(--c-paper); flex-wrap: wrap;
  }
  .title-left { flex: 1 1 360px; display: flex; flex-direction: column; gap: 8px; }
  .title-kicker { font-family: var(--font-mono); font-size: 13px; letter-spacing: 1px; color: var(--c-red); }
  .title-heading {
    font-family: var(--font-display); font-size: clamp(40px, 6vw, 88px); font-weight: 800;
    font-style: italic; line-height: 0.95; letter-spacing: -1px; color: var(--c-ink);
  }
  .title-sub { font-family: var(--font-ui); font-size: 16px; line-height: 1.4; color: var(--c-muted); max-width: 560px; }

  .results-count { display: flex; flex-direction: column; align-items: flex-end; }
  .results-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px; color: var(--c-muted); }
  .results-number { font-family: var(--font-display); font-size: clamp(40px, 5vw, 64px); font-weight: 800; font-style: italic; line-height: 0.95; color: var(--c-ink); }
  .results-text { font-family: var(--font-ui); font-size: 13px; color: var(--c-muted); }

  .main-area {
    display: grid; grid-template-columns: 280px 1fr;
    gap: clamp(20px, 2.5vw, 40px);
    padding: clamp(28px, 4vw, 56px) var(--gutter);
    background: var(--c-paper);
  }

  .sidebar {
    display: flex; flex-direction: column; gap: 24px;
    padding: 24px; border: 1px solid var(--c-line);
    border-radius: var(--radius-md); background: var(--c-paper);
    align-self: flex-start; position: sticky; top: 88px;
    max-height: calc(100vh - 88px - 24px);
  }

  .sb-header { display: flex; justify-content: space-between; align-items: center; }
  .sb-title { font-family: var(--font-display); font-size: 20px; font-weight: 800; letter-spacing: 1px; }
  .sb-count { font-family: var(--font-mono); font-size: 11px; color: var(--c-muted); }
  .sb-body {
    display: flex; flex-direction: column; gap: 24px; min-height: 0;
    flex: 1; overflow-y: auto; padding-right: 8px;
  }
  .sb-body::-webkit-scrollbar { width: 2px; }
  .sb-body::-webkit-scrollbar-track { background: transparent; }
  .sb-body::-webkit-scrollbar-thumb { background: var(--c-line-hard); border-radius: 999px; }

  /* Drawer-only elements: hidden on desktop */
  .drawer-close-btn,
  .drawer-footer,
  .drawer-backdrop,
  .mobile-toolbar { display: none; }

