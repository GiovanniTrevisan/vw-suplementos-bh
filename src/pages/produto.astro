---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { ChevronRight, Plus, Minus, ShoppingBag, MessageCircle, Heart, Share2, Shield } from '@lucide/astro';
---

<Layout title="Produto — VW Suplementos BH">
  <Header />

  <div class="breadcrumb-wrap">
    <div class="breadcrumb container">
      <a href="/">INÍCIO</a>
      <ChevronRight size={12} />
      <a href="/catalogo">CATÁLOGO</a>
      <ChevronRight size={12} />
      <span class="active" data-bc-cat>—</span>
      <ChevronRight size={12} />
      <span class="active" data-bc-name>—</span>
    </div>
  </div>

  <div data-state-loading class="state-block">
    <div class="loader"></div>
    <span>Carregando produto...</span>
  </div>

  <div data-state-error class="state-block error" hidden>
    <span class="state-title">Produto não encontrado.</span>
    <span class="state-msg" data-error-msg></span>
    <a href="/catalogo" class="btn-retry">Voltar ao catálogo</a>
  </div>

  <section class="product-block container" data-state-product hidden>
    <div class="gallery">
      <div class="gallery-main">
        <img data-product-img alt="" />
      </div>
    </div>

    <div class="info">
      <div class="info-meta">
        <span class="info-brand" data-product-cat>—</span>
        <span class="info-sku">SKU: <span data-product-sku></span></span>
      </div>

      <h1 class="info-name" data-product-name></h1>

      <div class="info-prices">
        <div class="price-row">
          <span class="price-current" data-product-price></span>
        </div>
      </div>

      <div class="info-divider"></div>

      <p class="info-desc" data-product-desc></p>

      <div class="info-divider"></div>

      <div class="qty-section">
        <span class="qty-label">QUANTIDADE</span>
        <div class="qty-controls">
          <button class="qty-btn" data-qty-dec type="button"><Minus size={16} /></button>
          <span class="qty-value" data-qty>1</span>
          <button class="qty-btn" data-qty-inc type="button"><Plus size={16} /></button>
        </div>
      </div>

      <div class="action-btns">
        <button class="btn-add" type="button" data-add-cart>
          <ShoppingBag size={18} />
          <span>ADICIONAR AO CARRINHO</span>
        </button>
        <button class="btn-whatsapp" type="button" data-buy-wa>
          <MessageCircle size={18} />
          <span>COMPRAR VIA WHATSAPP</span>
        </button>
      </div>

      <div class="quick-info">
        <div class="qi-item">
          <Shield size={16} color="var(--c-yellow)" />
          <span>Produto original com nota fiscal</span>
        </div>
        <div class="qi-item">
          <Shield size={16} color="var(--c-yellow)" />
          <span>Entrega em BH no mesmo dia</span>
        </div>
      </div>

      <div class="share-row">
        <button class="icon-btn" type="button" aria-label="Favoritar"><Heart size={18} /></button>
        <button class="icon-btn" type="button" aria-label="Compartilhar" data-share><Share2 size={18} /></button>
      </div>
    </div>
  </section>

  <section class="related-section" data-related-section hidden>
    <div class="rel-inner container">
      <div class="rel-header">
        <div class="rel-title-wrap">
          <span class="rel-kicker">TALVEZ VOCÊ GOSTE</span>
          <h2 class="rel-title">PRODUTOS RELACIONADOS.</h2>
        </div>
      </div>
      <div class="rel-grid" data-related-grid></div>
    </div>
  </section>
</Layout>

<script>
  import { fetchCatalog, relatedProducts } from '../lib/api';
  import type { Product } from '../lib/api';
  import { cart } from '../lib/cart';
  import { formatBRL, buildWhatsAppLink } from '../lib/format';
  import { WHATSAPP_NUMBER } from '../lib/config';

  const params = new URLSearchParams(location.search);
  const productId = params.get('id') || '';

  const stateLoad  = document.querySelector<HTMLElement>('[data-state-loading]')!;
  const stateErr   = document.querySelector<HTMLElement>('[data-state-error]')!;
  const stateProd  = document.querySelector<HTMLElement>('[data-state-product]')!;
  const errMsg     = document.querySelector<HTMLElement>('[data-error-msg]')!;
  const relSection = document.querySelector<HTMLElement>('[data-related-section]')!;
  const relGrid    = document.querySelector<HTMLElement>('[data-related-grid]')!;

  let qty = 1;
  let current: Product | null = null;

  function setQty(n: number) {
    qty = Math.max(1, n);
    document.querySelector<HTMLElement>('[data-qty]')!.textContent = String(qty);
  }

  function showError(msg: string) {
    stateLoad.hidden = true;
    stateErr.hidden = false;
    errMsg.textContent = msg;
  }

  function hydrate(p: Product) {
    document.title = `${p.nome} — VW Suplementos BH`;
    document.querySelector<HTMLElement>('[data-bc-cat]')!.textContent = (p.categoria || '').toUpperCase();
    document.querySelector<HTMLElement>('[data-bc-name]')!.textContent = p.nome.toUpperCase();
    document.querySelector<HTMLElement>('[data-product-cat]')!.textContent = p.categoria || '';
    document.querySelector<HTMLElement>('[data-product-sku]')!.textContent = `VW-${p.id}`;
    document.querySelector<HTMLElement>('[data-product-name]')!.textContent = p.nome;
    document.querySelector<HTMLElement>('[data-product-price]')!.textContent = formatBRL(p.preco);
    document.querySelector<HTMLElement>('[data-product-desc]')!.textContent =
      p.descricao || 'Sem descrição cadastrada.';
    const img = document.querySelector<HTMLImageElement>('[data-product-img]')!;
    if (p.imagem) {
      img.src = p.imagem;
      img.alt = p.nome;
    } else {
      img.removeAttribute('src');
      img.style.display = 'none';
    }
  }

  function renderRelated(items: Product[]) {
    if (!items.length) {
      relSection.hidden = true;
      return;
    }
    relSection.hidden = false;
    relGrid.innerHTML = '';
    items.forEach((p) => {
      const a = document.createElement('a');
      a.className = 'rel-card';
      a.href = `/produto?id=${encodeURIComponent(p.id)}`;
      a.innerHTML = `
        <div class="rel-img">${p.imagem ? `<img src="${p.imagem}" alt="" loading="lazy" />` : ''}</div>
        <div class="rel-body">
          <span class="rel-cat"></span>
          <span class="rel-name"></span>
          <span class="rel-price"></span>
        </div>
      `;
      (a.querySelector('.rel-cat')!).textContent = (p.categoria || '').toUpperCase();
      (a.querySelector('.rel-name')!).textContent = p.nome;
      (a.querySelector('.rel-price')!).textContent = formatBRL(p.preco);
      relGrid.appendChild(a);
    });
  }

  document.querySelector<HTMLButtonElement>('[data-qty-inc]')!.addEventListener('click', () => setQty(qty + 1));
  document.querySelector<HTMLButtonElement>('[data-qty-dec]')!.addEventListener('click', () => setQty(qty - 1));

  document.querySelector<HTMLButtonElement>('[data-add-cart]')!.addEventListener('click', () => {
    if (!current) return;
    cart.add(current, qty);
    const btn = document.querySelector<HTMLButtonElement>('[data-add-cart]')!;
    const span = btn.querySelector('span')!;
    const original = span.textContent;
    span.textContent = 'ADICIONADO ✓';
    setTimeout(() => { span.textContent = original; }, 1300);
  });

  document.querySelector<HTMLButtonElement>('[data-buy-wa]')!.addEventListener('click', () => {
    if (!current) return;
    const total = current.preco * qty;
    const lines = [
      '*Olá! Quero comprar pelo site:*',
      '',
      `Categoria: ${current.categoria}`,
      `Produto: ${current.nome}`,
      `Quantidade: ${qty}`,
      `Subtotal: ${formatBRL(total)}`,
      '',
      'Aguardo confirmação de disponibilidade e forma de pagamento.',
    ];
    location.href = buildWhatsAppLink(WHATSAPP_NUMBER, lines.join('\n'));
  });

  document.querySelector<HTMLButtonElement>('[data-share]')!.addEventListener('click', async () => {
    if (!current) return;
    const url = location.href;
    if (navigator.share) {
      try { await navigator.share({ title: current.nome, url }); } catch { /* user canceled */ }
    } else {
      try {
        await navigator.clipboard.writeText(url);
        alert('Link copiado!');
      } catch { /* ignore */ }
    }
  });

  async function load() {
    if (!productId) {
      showError('ID do produto não informado na URL (ex.: /produto?id=1).');
      return;
    }
    const data = await fetchCatalog();
    if (!data.ok) {
      showError(data.error || 'Não foi possível carregar o catálogo.');
      return;
    }
    const p = data.products.find((x) => x.id === productId);
    if (!p) {
      showError('O produto pode ter sido removido ou desativado.');
      return;
    }
    current = p;
    stateLoad.hidden = true;
    stateProd.hidden = false;
    hydrate(p);
    renderRelated(relatedProducts(data.products, p, 4));
  }

  load();
</script>

<style>
  .breadcrumb-wrap { background: var(--c-paper); border-bottom: 1px solid var(--c-line); }
  .breadcrumb {
    display: flex; align-items: center; gap: 10px;
    padding: 18px var(--gutter);
    font-family: var(--font-mono); font-size: 11px; font-weight: 500;
    letter-spacing: 1.5px; color: var(--c-muted);
    flex-wrap: wrap;
  }
  .breadcrumb a { color: var(--c-muted); transition: color var(--t-fast) var(--ease-out); }
  .breadcrumb a:hover { color: var(--c-ink); }
  .breadcrumb .active { color: var(--c-ink); font-weight: 700; }

  .state-block {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 10px; min-height: 480px; text-align: center;
    font-family: var(--font-ui); font-size: 14px; color: var(--c-muted);
    background: var(--c-paper);
  }
  .state-title { font-family: var(--font-display); font-size: 28px; font-weight: 800; color: var(--c-ink); }
  .state-block.error .state-title { color: var(--c-red); }
  .state-msg { max-width: 480px; font-size: 13px; }
  .loader {
    width: 36px; height: 36px;
    border: 3px solid var(--c-line); border-top-color: var(--c-yellow);
    border-radius: 50%; animation: spin 800ms linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .btn-retry {
    margin-top: 6px; padding: 12px 22px;
    background: var(--c-ink); color: var(--c-paper);
    border-radius: var(--radius-pill);
    font-family: var(--font-display); font-size: 13px; font-weight: 800; letter-spacing: 1px;
  }
  .btn-retry:hover { background: var(--c-yellow); color: var(--c-ink); }

  .product-block {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    padding: clamp(28px, 4vw, 56px) var(--gutter);
    background: var(--c-paper);
  }

  .gallery { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .gallery-main {
    width: 100%; aspect-ratio: 1; background: var(--c-mid);
    border-radius: var(--radius-md); overflow: hidden;
    box-shadow: 0 30px 80px -40px rgba(10, 10, 9, 0.4);
  }
  .gallery-main img { width: 100%; height: 100%; object-fit: cover; }

  .info { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .info-meta { display: flex; justify-content: space-between; align-items: center; }
  .info-brand { font-family: var(--font-mono); font-size: 12px; font-weight: 700; letter-spacing: 2px; color: var(--c-muted); }
  .info-sku { font-family: var(--font-mono); font-size: 11px; color: var(--c-muted); }

  .info-name {
    font-family: var(--font-display); font-size: clamp(32px, 4vw, 56px); font-weight: 800;
    font-style: italic; line-height: 0.95; letter-spacing: -2px; color: var(--c-ink);
  }

  .info-prices { display: flex; flex-direction: column; gap: 8px; }
  .price-row { display: flex; align-items: baseline; gap: 12px; }
  .price-current { font-family: var(--font-mono); font-size: 32px; font-weight: 700; color: var(--c-ink); }

  .info-divider { height: 1px; background: var(--c-line); }
  .info-desc { font-family: var(--font-ui); font-size: 15px; line-height: 1.6; color: var(--c-muted); }

  .qty-section { display: flex; flex-direction: column; gap: 12px; }
  .qty-label { font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 2px; color: var(--c-muted); }
  .qty-controls { display: flex; align-items: center; gap: 16px; }
  .qty-btn {
    width: 40px; height: 40px; border: 1px solid var(--c-line-hard); border-radius: var(--radius-sm);
    display: flex; align-items: center; justify-content: center; background: var(--c-paper);
  }
  .qty-value { font-family: var(--font-mono); font-size: 18px; font-weight: 700; }

  .action-btns { display: flex; flex-direction: column; gap: 12px; }
  .btn-add {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    padding: 18px; background: var(--c-yellow); border-radius: var(--radius-sm);
    font-family: var(--font-display); font-size: 16px; font-weight: 800; letter-spacing: 1px;
    color: var(--c-ink);
    transition: transform var(--t-med) var(--ease-out), box-shadow var(--t-med) var(--ease-out);
  }
  .btn-add:hover { transform: translateY(-3px); box-shadow: 0 16px 36px -12px rgba(245, 195, 0, 0.55); }
  .btn-whatsapp {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    padding: 18px; border: 2px solid var(--c-ink); border-radius: var(--radius-sm);
    font-family: var(--font-display); font-size: 16px; font-weight: 800; letter-spacing: 1px;
    color: var(--c-ink); background: transparent;
    transition: background var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out), transform var(--t-med) var(--ease-out);
  }
  .btn-whatsapp:hover { background: var(--c-ink); color: var(--c-paper); transform: translateY(-3px); }

  .quick-info { display: flex; flex-direction: column; gap: 8px; }
  .qi-item { display: flex; align-items: center; gap: 8px; font-family: var(--font-ui); font-size: 13px; color: var(--c-muted); }

  .share-row { display: flex; gap: 12px; }
  .icon-btn {
    width: 40px; height: 40px; border: 1px solid var(--c-line-hard); border-radius: var(--radius-sm);
    display: flex; align-items: center; justify-content: center; background: var(--c-paper);
    color: var(--c-muted);
  }

  .related-section { background: var(--c-ink); }
  .rel-inner {
    display: flex; flex-direction: column; gap: clamp(24px, 3vw, 40px);
    padding: clamp(48px, 6vw, 80px) var(--gutter);
  }
  .rel-header { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
  .rel-title-wrap { display: flex; flex-direction: column; gap: 8px; }
  .rel-kicker { font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 2px; color: var(--c-yellow); }
  .rel-title { font-family: var(--font-display); font-size: clamp(32px, 4vw, 56px); font-weight: 800; font-style: italic; line-height: 0.92; letter-spacing: -2px; color: var(--c-paper); }

  .rel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: clamp(14px, 1.4vw, 20px);
  }
  .rel-card {
    display: flex; flex-direction: column;
    border: 1px solid #F5F0E833; border-radius: var(--radius-md); overflow: hidden;
    transition: transform var(--t-med) var(--ease-out), box-shadow var(--t-med) var(--ease-out), border-color var(--t-med) var(--ease-out);
  }
  .rel-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 48px -20px rgba(0, 0, 0, 0.5);
    border-color: var(--c-yellow);
  }
  .rel-img { width: 100%; aspect-ratio: 1 / 1; background: var(--c-mid); }
  .rel-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .rel-body { display: flex; flex-direction: column; gap: 10px; padding: 16px; }
  .rel-cat { font-family: var(--font-mono); font-size: 11px; letter-spacing: 2px; color: #F5F0E8B3; }
  .rel-name { font-family: var(--font-display); font-size: 20px; font-weight: 700; color: var(--c-paper); letter-spacing: -0.5px; }
  .rel-price { font-family: var(--font-mono); font-size: 18px; font-weight: 700; color: var(--c-paper); }

  @media (max-width: 960px) {
    .product-block { grid-template-columns: 1fr; }
  }
</style>
