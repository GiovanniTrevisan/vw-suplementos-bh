---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { ArrowLeft, Home, MessageCircle } from '@lucide/astro';
---

<Layout title="404 — Página não encontrada · VW Suplementos BH">
  <Header />

  <section class="main-404">
    <div class="glyph-404" aria-hidden="true">404</div>

    <div class="content-404 container" data-reveal="scale">
      <span class="kicker-404">// PÁGINA NÃO ENCONTRADA</span>

      <h1 class="title-404">EITA, ESSA<br/>ROTA NÃO<br/>EXISTE.</h1>

      <p class="sub-404">O link que você acessou pode estar quebrado ou a página foi removida. Mas não esquenta — o treino continua.</p>

      <div class="btns-404">
        <a href="/" class="btn-404 primary">
          <Home size={18} />
          <span>VOLTAR AO INÍCIO</span>
        </a>
        <a href="/catalogo" class="btn-404 secondary">
          <ArrowLeft size={18} />
          <span>VER CATÁLOGO</span>
        </a>
      </div>

      <div class="links-404">
        <a href="/#sobre">Sobre nós</a>
        <span class="dot">·</span>
        <a href="/#localizacao">Localização</a>
        <span class="dot">·</span>
        <a href="#">
          <MessageCircle size={14} />
          <span>WhatsApp</span>
        </a>
      </div>
    </div>
  </section>

  <footer class="footer-404">
    <div class="f-left">
      <span class="f-brand">VW SUPLEMENTOS</span>
      <span class="f-sep"></span>
      <span>CASTELO BH</span>
    </div>
    <div class="f-right">
      <span>© 2026 · TODOS OS DIREITOS RESERVADOS</span>
    </div>
  </footer>
</Layout>

<style>
  .main-404 {
    position: relative;
    width: 100%;
    min-height: clamp(640px, 80vh, 880px);
    background: var(--c-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: clamp(32px, 5vw, 64px) var(--gutter);
  }
  .main-404::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(245, 195, 0, 0.08), transparent 60%);
    pointer-events: none;
  }

  .glyph-404 {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-size: clamp(180px, 32vw, 520px);
    font-weight: 800;
    font-style: italic;
    line-height: 0.85;
    letter-spacing: -0.06em;
    color: var(--c-yellow);
    opacity: 0.12;
    text-align: center;
    user-select: none;
    pointer-events: none;
    animation: floatY 6s var(--ease-in-out) infinite;
  }

  .content-404 {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
  }

  .kicker-404 {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--c-yellow);
  }

  .title-404 {
    font-family: var(--font-display);
    font-size: clamp(40px, 7vw, 96px);
    font-weight: 800;
    font-style: italic;
    line-height: 0.9;
    letter-spacing: -3px;
    color: var(--c-paper);
  }

  .sub-404 {
    max-width: 480px;
    font-family: var(--font-ui);
    font-size: 16px;
    line-height: 1.6;
    color: #F5F0E8B3;
  }

  .btns-404 {
    display: flex;
    gap: 12px;
  }

  .btn-404 {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 26px;
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
    transition: transform var(--t-med) var(--ease-out), box-shadow var(--t-med) var(--ease-out), background var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out);
  }

  .btn-404.primary {
    background: var(--c-yellow);
    color: var(--c-ink);
  }
  .btn-404.primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px -12px rgba(245, 195, 0, 0.55);
  }

  .btn-404.secondary {
    border: 2px solid #F5F0E833;
    color: var(--c-paper);
  }
  .btn-404.secondary:hover {
    border-color: var(--c-paper);
    transform: translateY(-3px);
  }

  .links-404 {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
  }

  .links-404 a {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    color: #F5F0E8B3;
    transition: color 0.2s;
  }

  .links-404 a:hover { color: var(--c-paper); }

  .dot {
    color: #F5F0E833;
    font-size: 12px;
  }

  .footer-404 {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 60px;
    padding: 16px var(--gutter);
    background: var(--c-ink);
    border-top: 1px solid #FFFFFF1F;
    flex-wrap: wrap;
    gap: 12px;
  }

  .f-left {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .f-brand {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--c-paper-muted);
  }

  .f-sep {
    width: 1px;
    height: 14px;
    background: #FFFFFF1F;
  }

  .f-left span,
  .f-right span {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--c-paper-muted);
  }

  .f-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  @media (max-width: 600px) {
    .btns-404 { flex-direction: column; width: 100%; }
    .btn-404 { justify-content: center; }
    .footer-404 { justify-content: center; text-align: center; }
    .f-left { justify-content: center; }
  }
</style>
